@section Scripts {
    <!--Importar los scripts necesarios-->
    <script src="https://cdn.jsdelivr.net/npm/ag-grid-community/dist/ag-grid-community.min.js"></script>
    <script src="~/js/pages/patients/griddefinition.js"></script>
    <script src="~/js/pages/patients/patientlist.js"></script>
}
<div class="text-center">
    <h6 class="display-4">Patient List</h6>

    <div id="myGrid" style="height: 300px; width:70%;" class="ag-theme-alpine"></div>
</div>
<div class="form-group">
    <div class="text-center">
        <h6 class="display-4">Patient Details</h6>
    </div>
    <!--Formulario para mostrar datos de la Lista-->
    <form id="frmPatients">
        <div>
            <label for="txtSocialSecId">No.Seguro Social:</label>
            <input id="txtSocialSecId" type="text" readonly="readonly" class="form-control" />
        </div>

        <div>
            <label for="txtName">Nombre:</label>
            <input id="txtName" type="text" readonly="readonly" class="form-control" />
        </div>

        <div>
            <label for="txtLastName">Apellido:</label>
            <input id="txtLastName" type="text" readonly="readonly" class="form-control" />
        </div>
        <div class="form-group">
            <button type="button" class="btn btn-success" id="btnVerCitas">Ver Citas</button>
        </div>
    </form>
</div>
